<Window x:Class="Pr4PogosyanNikolaeva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pr4PogosyanNikolaeva"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Margin="10 0 20 0" VerticalAlignment="Center">
            <TextBlock Text="Операнд" FontSize="30"/>
            <TextBox x:Name="TxtBoxOp1" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10 20 20 0" >
            <TextBlock Text="Операнд" FontSize="30"/>
            <TextBox x:Name="TxtBoxOp2" Height="30"/>
        </StackPanel>
        <GroupBox  Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Header="Операция" FontSize="25" >
            <StackPanel>
                <RadioButton GroupName="GroupOpetaions" Content="+" FontSize="30" IsChecked="True" Checked="RadioButton_Checked"/>
                <RadioButton GroupName="GroupOpetaions" Content="-" FontSize="30" Checked="RadioButton_Checked"/>
                <RadioButton GroupName="GroupOpetaions" Content="*" FontSize="30" Checked="RadioButton_Checked"/>
                <RadioButton GroupName="GroupOpetaions" Content="/" FontSize="30" Checked="RadioButton_Checked"/>
            </StackPanel>
        </GroupBox>
       

        <Button x:Name="BtnCalculate" Content="Вычислить" FontSize="25" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Foreground="White" Height="50" Margin="10 0 10 0"  Click="BtnCalculate_Click" Background="#FFFF72B2"/>

        <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center" Margin="20 0 0 0">
            <TextBlock Text="Результат" FontSize="30" Margin="0 0 0 10"/>
            <TextBox x:Name="TxtBoxRes" Height="30" IsReadOnly="True"/>
        </StackPanel>

    </Grid>
</Window>

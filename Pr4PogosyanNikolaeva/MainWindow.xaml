<Window x:Class="Pr4PogosyanNikolaeva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pr4PogosyanNikolaeva"
        mc:Ignorable="d"
        Title="Вычисление заработной платы" Height="190" Width="559" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock  Text="Количество часов" Margin="5 0" VerticalAlignment="Center" />
            <TextBox  Width="150" Height="20" Text="0" x:Name="CountHourBox"/>
        </StackPanel>

        <CheckBox Grid.Row="1" Content="Подоходный налог (13%)" Margin="5 0" Click="CheckBox_Click"/>

        <StackPanel Grid.Row="2" Margin="5 0" Orientation="Horizontal" Visibility="Hidden" x:Name="NalogStack">
            <TextBlock Text="Начислено в том числе налог:" TextWrapping="Wrap" Margin="3 0"/>
            <TextBlock Text="0,00 ₽" FontWeight="Medium" x:Name="NalogText"/>
        </StackPanel>

        <GroupBox Grid.Column="1" Margin="10" Header="Преподаватель" Grid.RowSpan="3">
            <StackPanel>
                <RadioButton GroupName="0" Content="ассистент" Margin="5" IsChecked="True" Checked="RadioButton_Checked"/>
                <RadioButton GroupName="0" Content="доцент" Margin="5" Checked="RadioButton_Checked"/>
                <RadioButton GroupName="0" Content="профессор" Margin="5" Checked="RadioButton_Checked"/>
            </StackPanel>
        </GroupBox>

        <Button Margin="10 0" Content="Вычислить" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" Padding="10 3" Click="Button_Click"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="5 0">
            <!--<TextBlock Text="Ответ:"  FontSize="16" FontWeight="Medium" Margin="3 0"/>-->
            <TextBlock x:Name="answer" Text="Зарплата: 0,00 ₽" FontSize="16" FontWeight="Medium"/>
        </StackPanel>

    </Grid>
</Window>

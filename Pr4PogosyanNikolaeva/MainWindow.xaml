<Window x:Class="Pr4PogosyanNikolaeva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pr4PogosyanNikolaeva"
        mc:Ignorable="d"
        Title="MainWindow" Height="510" Width="800" Closing="Window_Closing">
    <Grid>
        <TabControl>
            <TabItem Header="Задание 1" ToolTip="Перейти к заданию 1 - вычисление функции с переменными x, y, z">
                <Grid Background="#FFE5E5E5">
                    <Frame Source="/Pages/_1TaskPage.xaml" />

                </Grid>
            </TabItem>
            <TabItem Header="Задание 2" ToolTip="Перейти к заданию 2 - вычисление функции с выбором sh(x), x² или e^x">
                <Grid Background="#FFE5E5E5">
                    <Frame Source="/Pages/_2TaskPage.xaml" />
                    
                </Grid>
            </TabItem>
            <TabItem Header="Задание 3" ToolTip="Перейти к заданию 3 - построение графика функции с параметром b">
                <Grid Background="#FFE5E5E5">
                    <Frame Source="/Pages/_3TaskPage.xaml" />
                    
                </Grid>
            </TabItem>
        </TabControl>
        <Border BorderBrush="Black" BorderThickness="1"/>

    </Grid>
</Window>

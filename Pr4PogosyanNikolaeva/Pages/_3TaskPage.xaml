<Page x:Class="Pr4PogosyanNikolaeva.Pages._3TaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr4PogosyanNikolaeva.Pages"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      mc:Ignorable="d" 
      d:DesignHeight="455" d:DesignWidth="800"
      Title="_3TaskPage">

    <Grid Background="White" >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <!--<ColumnDefinition Width="auto"/>-->
        </Grid.ColumnDefinitions>
        <Image Source="/Images/Task3.png" Grid.Row="0" Grid.ColumnSpan="3" Height="100" ToolTip="Формула задания 3"/>

        <TextBlock Text="x0" Grid.Row="1" Grid.Column="0" Margin="10" FontSize="16" ToolTip="Начальное значение отрезка"/>
        <TextBox HorizontalAlignment="Left" x:Name="txtX0" Grid.Row="1" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" FontSize="20" 
                 PreviewTextInput="TxtBoxX0_PreviewTextInput" Text="0" TextChanged="TxtBoxB_TextChanged" ToolTip="Введите начальное значение x (x0)"/>

        <TextBlock Text="xk" Grid.Row="2" Grid.Column="0" Margin="10" FontSize="20" ToolTip="Конечное значение отрезка"/>
        <TextBox HorizontalAlignment="Left" x:Name="txtXK" Grid.Row="2" Grid.Column="1" MinWidth="200"  VerticalAlignment="Center" FontSize="20" 
                 PreviewTextInput="TxtBoxXk_PreviewTextInput" Text="0" TextChanged="TxtBoxB_TextChanged" ToolTip="Введите конечное значение x (xk, должно быть больше x0)"/>

        <TextBlock Text="dx" Grid.Row="3" Grid.Column="0" Margin="10" FontSize="16" ToolTip="Шаг изменения x"/>
        <TextBox HorizontalAlignment="Left" x:Name="txtDX" Grid.Row="3" Grid.Column="1" MinWidth="200"  VerticalAlignment="Center" FontSize="20" 
                 PreviewTextInput="TxtBoxDx_PreviewTextInput" Text="0" TextChanged="TxtBoxB_TextChanged" ToolTip="Введите шаг dx (положительное число)"/>

        <TextBlock Text="b" Grid.Row="4" Grid.Column="0" Margin="10" FontSize="16" ToolTip="Параметр b"/>
        <TextBox HorizontalAlignment="Left" x:Name="txtB" Grid.Row="4" Grid.Column="1" MinWidth="200"  VerticalAlignment="Center" FontSize="20" 
                 PreviewTextInput="TxtBoxB_PreviewTextInput" Text="0" TextChanged="TxtBoxB_TextChanged" ToolTip="Введите значение параметра b"/>


        <TextBlock Text="Ответ" Grid.Row="5" Margin="5" FontSize="16" FontWeight="Medium" ToolTip="Результаты вычислений"/>
        
        <TextBox x:Name="boxAnswer" IsReadOnly="True" MinWidth="150" Grid.Row="5" Grid.Column="1" MinHeight="50" MaxHeight="100" MaxWidth="200" 
                 FontSize="16" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                 ToolTip="Отображение всех вычисленных значений x и y"/>


        <Button Content="Вычислить" x:Name="btnCalculate" Margin="0 5 0 0" Grid.Column="1" Grid.Row="6" Background="LightBlue" Height="30" FontSize="15" Padding="5 0" 
                Click="btnCalculate_Click" ToolTip="Построить график и вычислить значения функции"/>
        <Button Content="Очистить" Grid.Column="1" x:Name="btnClear" Margin="0 5 0 0" Grid.Row="7" Background="LightBlue"  Height="30" FontSize="15" Padding="5 0" 
                Click="btnClear_Click" ToolTip="Очистить все поля и график"/>
        <WindowsFormsHost Grid.Column="2" Grid.RowSpan="5" Grid.Row="1" ToolTip="Область построения графика функции">

            <charts:Chart x:Name="FunctionChart" >
                <charts:Chart.Legends>
                    <charts:Legend>

                    </charts:Legend>
                </charts:Chart.Legends>
            </charts:Chart>
        </WindowsFormsHost>








    </Grid>
</Page>

<Page x:Class="Pr4PogosyanNikolaeva.Pages._2TaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr4PogosyanNikolaeva.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_2TaskPage">

    <Grid Background="White" >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <!--<ColumnDefinition Width="auto"/>-->
        </Grid.ColumnDefinitions>
        <Image Source="/Images/Task2.png" Grid.Row="0" Grid.ColumnSpan="3" Height="150" ToolTip="Формула задания 2"/>

        <TextBlock Text="x" Grid.Row="1" Grid.Column="0" Margin="10" FontSize="20" ToolTip="Переменная x"/>
        <TextBox HorizontalAlignment="Left" x:Name="txtX" Grid.Row="1" Grid.Column="1" MinWidth="200"  VerticalAlignment="Center" FontSize="20"
                 PreviewTextInput="txtX_PreviewTextInput" Text="0" TextChanged="txtX_TextChanged" ToolTip="Введите значение переменной x"/>

        <TextBlock Text="y" Grid.Row="2" Grid.Column="0" Margin="10" FontSize="20" ToolTip="Переменная y"/>
        <TextBox HorizontalAlignment="Left" x:Name="txtY" Grid.Row="2" Grid.Column="1" MinWidth="200"  VerticalAlignment="Center" FontSize="20" 
                 Text="0" TextChanged="txtX_TextChanged" PreviewTextInput="txtY_PreviewTextInput" ToolTip="Введите значение переменной y"/>

        <StackPanel Grid.Row="3" Grid.Column="1" Grid.RowSpan="2" ToolTip="Выберите функцию для вычисления">
            <RadioButton  GroupName="0" Content="sh(x)" Margin="0 5" x:Name="rad1" IsChecked="True" Checked="rad1_Checked"  ToolTip="Гиперболический синус sh(x)"/>
            <RadioButton GroupName="0" Content="x^2" Margin="0 5" x:Name="rad2" Checked="rad1_Checked" ToolTip="x в квадрате"/>
            <RadioButton GroupName="0" Content="e^x" Margin="0 5" x:Name="rad3" Checked="rad1_Checked" ToolTip="Экспонента e^x"/>
        </StackPanel>

        <TextBlock Text="Ответ" Grid.Row="5" Margin="5" FontSize="20" FontWeight="Medium" ToolTip="Результат вычисления"/>
        <TextBox x:Name="boxAnswer" MinWidth="150" Grid.Row="5" Grid.Column="1" Height="30" FontSize="20" IsReadOnly="True" ToolTip="Отображение результата вычисления"/>
        <Button Content="Вычислить" x:Name="btnCalculate" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Left" Width="100" Height="30" 
                FontSize="15" Padding="5 0" Click="btnCalculate_Click" Background="LightBlue" ToolTip="Вычислить значение по формуле с выбранной функцией"/>
        <Button Content="Очистить" Grid.Column="2" x:Name="btnClear" Grid.Row="4" HorizontalAlignment="Left" Background="LightBlue" Width="100" Height="30" FontSize="15" 
                Padding="5 0" Click="btnClear_Click" ToolTip="Сбросить все поля"/>
    </Grid>
</Page>
